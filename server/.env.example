PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/civiclens
JWT_SECRET=change-me
CLIENT_URL=http://localhost:5173

# ---- Cloudflare Tunnel (for Mobile access) ----
# When you expose your server to mobile via Cloudflare Tunnel:
# cloudflared tunnel --url http://localhost:5000
# Set PUBLIC_URL to the generated https://*.trycloudflare.com tunnel URL
# so mobile devices can display uploaded images directly:
PUBLIC_URL=http://localhost:5000

# ---- AI Engine ----
# Default: Local open-weight vision model running in Ollama
OLLAMA_URL=http://127.0.0.1:11434
VISION_MODEL=qwen3-vl:4b-instruct
AI_TIMEOUT_MS=180000
AI_MODE=ollama

# Optional: Cloudflare Workers AI (if you want cloud AI instead of local Ollama)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# AI_MODEL=@cf/llava-hf/llava-1.5-7b-hf

# Tunables
DUP_RADIUS_M=50
VERIFY_THRESHOLD=1
MAX_LOCATION_ACCURACY_M=20
ADMIN_EMAILS=admin@civiclens.dev
